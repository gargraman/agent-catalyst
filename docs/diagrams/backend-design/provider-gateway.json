  "cards": [
    { "dot": "cyan", "title": "The contract", "items": ["One NormalizedRequest / StreamEvent / Usage IR — nothing above the gateway imports a provider SDK type", "Events re-encode 1:1 to the graph and SSE; the graph is model-agnostic at the stream level", "LangGraph owns the loop; the gateway owns transport, cost, normalization — never the other way round"] },
    { "dot": "rose", "title": "Cost is ours, not the vendor's", "items": ["attach_cost = compute_cost(profile, usage) from our versioned capability profiles — LiteLLM's cost field is never trusted", "Single authority for runs.cost_usd, spans.cost_usd, eval cost deltas, COGS dashboards", "The resolved profile is snapshotted into agent_versions.profile_snapshot, so a price/feature change is a drift trigger, not a silent shift", "Prices cached_input / cache_write / reasoning tokens at their own rates; batch=True (eval/ingest) applies the batch multiplier"] },
    { "dot": "amber", "title": "Resilience", "items": ["retry ≤ 3 on 429 / 5xx / timeout only, backoff + jitter, respects Retry-After", "circuit breaker per (provider,model), state in Redis shared across api + worker", "on breaker-open or exhausted → the version's pinned fallback model (recorded like a substitution)", "idempotency dedupe on idempotency_key so a retry can't double-bill"] },
    { "dot": "emerald", "title": "Substitution — the leak made visible", "items": ["supports() returns the downgrades a provider needs (dropped / emulated_via_prompt / downgraded) instead of silently dropping", "Each is emitted as a span attribute and attached to the Run", "At eval time a substitution counts against the verdict; on a published run it is a warning", "Opting into a provider-specific feature then switching provider → non-portable version → forced re-eval"] },
    { "dot": "slate", "title": "Source", "items": ["docs/backend/02-provider-gateway.md §IR/§adapter/§profiles/§cost/§invoke-path · 07-cost-cogs.md · 01 (profile_snapshot)", "services/runtime/providers/{ir,gateway,cost,adapters,profiles}.py — companion: runtime-invoke-pipeline.html"] }
