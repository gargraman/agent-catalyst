{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "Runtime & Governance Schema — Tools/MCP, Publish, Runs, Ops, Adoption",
    "subtitle": "Postgres+pgvector (docs/backend/01). Part 2 of 2 — anchors re-shown from Part 1. Includes PROPOSED mcp_user_connections / auth_mode (doc 17).",
    "quality_profile": "standard",
    "output": "docs/diagrams/backend-design/schema-runtime-governance.html",
    "views": [
      {
        "id": "approval",
        "label": "Tool approval path",
        "focus": [
          "tool_bindings",
          "tool_approvals",
          "runs",
          "subagent_configs",
          "agent_versions"
        ],
        "note": "a frozen tool_binding with requires_approval parks the run; a publisher decides on tool_approvals."
      },
      {
        "id": "record",
        "label": "Run → spans → cost",
        "focus": [
          "runs",
          "spans",
          "api_tokens",
          "published_endpoints",
          "agent_versions"
        ],
        "note": "a published endpoint pins one version; a caller token drives a run; every model/tool/retrieval step is a span with cost_usd."
      },
      {
        "id": "adoption",
        "label": "Adoption & drift notify",
        "focus": [
          "agent_signatures",
          "agents",
          "agent_versions",
          "notifications"
        ],
        "note": "agent_signatures is the pgvector dedup fingerprint at registration; notifications fan drift/eval/budget to the owner."
      }
    ]
  },
  "layout": {
    "mode": "grid",
    "gapX": 58,
    "gapY": 24
  },
