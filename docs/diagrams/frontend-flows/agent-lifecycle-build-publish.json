    { "dot": "amber", "title": "Drift engine", "items": ["TRIGGER_FIELDS (provider, model, knowledgeBases, tools, skills) set needsReEval", "Any config change except spend also sets needsReEval", "Attaching / re-ingesting a KB or editing / publishing a bound skill trips it too"] },
    { "dot": "rose", "title": "Publish gate (hard block)", "items": ["publishAgent blocks on eval_failing, needsReEval, or low-confidence", "low-confidence is overridable only when policy allows", "On pass: status=published, endpoint assigned (mirrors server 409 eval_gate)", "Each version is an immutable snapshot the endpoint pins"] },
